APP_NAME=nordit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Devcontainer: MySQL do compose. Sem Docker, dá para usar DB_CONNECTION=sqlite.
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=cartorios
DB_USERNAME=cartorios
DB_PASSWORD=cartorios_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hospedagem sem worker: use "sync" (o e-mail sai na própria requisição; falha não bloqueia).
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local: "log" grava o e-mail em storage/logs. Produção: smtp com as credenciais reais.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@nordit.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- nordit ---
# Quem recebe o aviso de nova solicitação de proposta (substitui o Web3Forms). Vazio = não envia.
NORDIT_LEADS_MAIL_TO=
# WhatsApp oficial, só dígitos com DDI (ex.: 5581999990000).
NORDIT_WHATSAPP_NUMBER=

# Sysadmin inicial (php artisan db:seed). Sem e-mail, usa sysadmin@nordit.com.br; sem senha, gera
# uma e mostra uma única vez no terminal. Recuperar acesso: php artisan sysadmin:reset-password
SYSADMIN_NAME="Sysadmin nordit"
SYSADMIN_EMAIL=
SYSADMIN_PASSWORD=
